# PROJECT SETTINGS

PROJECT_NAME=docker4magento
PROJECT_BASE_URL=docker4magento.local
PROJECT_BASE_PORT=8000

DB_HOST=mysql
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=magento
DB_ROOT_PASSWORD=root

COMPOSER_MAGENTO_REPO_USERNAME=00000000000000000000000000000000
COMPOSER_MAGENTO_REPO_PASSWORD=00000000000000000000000000000000

MAGENTO_ROOT=/var/www/html/
MAGENTO_VERSION=2.4.0
MAGENTO_ADMIN_FIRSTNAME=John
MAGENTO_ADMIN_LASTNAME=Doe
MAGENTO_ADMIN_EMAIL=fake@email.tld
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=admin123
MAGENTO_LANGUAGE=en_US
MAGENTO_CURRENCY=USD
MAGENTO_TIMEZONE=Europe/Kiev
MAGENTO_BACKEND_FRONTNAME=admin

# SOFTWARE

#! Required software for Magento 2.4.0

# PHP_TAG=7.4.11
PHP_TAG=7.4.11-dev
# PHP_TAG=7.4.11-dev-macos
# PHP_TAG=7.4.9
# PHP_TAG=7.4.9-dev

MYSQL_TAG=8
ELASTICSEARCH_TAG=7.6.2

